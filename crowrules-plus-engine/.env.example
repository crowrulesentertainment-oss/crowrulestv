# CrowRules+ independent playout service — NEVER commit real secrets
NODE_ENV=production
PORT=8788
HOST=127.0.0.1
CR_CONTROL_TOKEN=replace-with-at-least-40-random-characters

SUPABASE_URL=https://cevylpnoexugwgygvtgu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
CR_OWNER_USER_ID=REPLACE_WITH_AUTH_USER_UUID

# Shared YouTube RTMP ingest base; unique stream key per channel below
RTMP_BASE_URL=rtmp://a.rtmp.youtube.com/live2
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=15000
RESTART_DELAY_MS=5000
FFMPEG_PRESET=veryfast
VIDEO_BITRATE=4500k
AUDIO_BITRATE=128k
VIDEO_SIZE=1920x1080
VIDEO_FPS=30

# Configure each key separately in the host's secret/environment settings.
# Do not use the same stream key for multiple channels.
CR_MAIN_STREAM_KEY=
CR_TACOMA_STREAM_KEY=
CR_PRODUCTIONS_STREAM_KEY=
CR_BACKDECK_STREAM_KEY=

# Optional local standby MP4 per channel; use absolute paths on a local host.
CR_MAIN_STANDBY_FILE=
CR_TACOMA_STANDBY_FILE=
CR_PRODUCTIONS_STANDBY_FILE=
CR_BACKDECK_STANDBY_FILE=
